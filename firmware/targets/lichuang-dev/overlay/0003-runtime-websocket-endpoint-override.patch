+namespace {
+
+constexpr size_t kMaxWebsocketUrlLength = 255;
+constexpr int kLocalProtocolVersion = 1;
+// NVS keys are limited to 15 characters; this stores logical protocol_version.
+constexpr const char* kProtocolVersionKey = "protocol_ver";
+
+struct WebsocketEndpointSnapshot {
+    std::string url;
+    std::string token;
+    std::string host;
+    const char* source = "none";
+    int version = kLocalProtocolVersion;
+
+    bool IsValid() const { return !url.empty(); }
+};
+
+bool ParseWebsocketUrl(const std::string& url, std::string& host) {
+    if (url.empty() || url.size() > kMaxWebsocketUrlLength ||
+        url.find('\0') != std::string::npos) {
+        return false;
+    }
+
+    http_parser_url parsed;
+    http_parser_url_init(&parsed);
+    if (http_parser_parse_url(url.data(), url.size(), false, &parsed) != 0) {
+        return false;
+    }
+
+    constexpr uint16_t kRequiredFields = (1U << UF_SCHEMA) | (1U << UF_HOST);
+    if ((parsed.field_set & kRequiredFields) != kRequiredFields) {
+        return false;
+    }
+
+    const auto& scheme_field = parsed.field_data[UF_SCHEMA];
+    const auto& host_field = parsed.field_data[UF_HOST];
+    const std::string scheme = url.substr(scheme_field.off, scheme_field.len);
+    if ((scheme != "ws" && scheme != "wss") || host_field.len == 0) {
+        return false;
+    }
+
+    host = url.substr(host_field.off, host_field.len);
+    return true;
+}
+
+WebsocketEndpointSnapshot MakeEndpointSnapshot(const std::string& url,
+                                               const std::string& token,
+                                               int version,
+                                               const char* source) {
+    WebsocketEndpointSnapshot endpoint;
+    if (version != kLocalProtocolVersion || !ParseWebsocketUrl(url, endpoint.host)) {
+        return endpoint;
+    }
+    endpoint.url = url;
+    endpoint.token = token;
+    endpoint.source = source;
+    return endpoint;
+}
+
+WebsocketEndpointSnapshot ResolveWebsocketEndpoint() {
+    Settings voice_agent("voice_agent", false);
+    Settings websocket("websocket", false);
+    const std::string upstream_token = websocket.GetString("token");
+    std::string voice_agent_token = voice_agent.GetString("token");
+    if (voice_agent_token.empty()) {
+#if VOICE_AGENT_LOCAL_LAB
+        voice_agent_token = VOICE_AGENT_WS_TOKEN;
+#else
+        voice_agent_token = upstream_token;
+#endif
+    }
+
+    auto endpoint = MakeEndpointSnapshot(
+        voice_agent.GetString("ws_url"),
+        voice_agent_token,
+        voice_agent.GetInt(kProtocolVersionKey, kLocalProtocolVersion),
+        "voice_agent_nvs");
+    if (endpoint.IsValid()) {
+        return endpoint;
+    }
+
+#if VOICE_AGENT_LOCAL_LAB
+    endpoint = MakeEndpointSnapshot(
+        VOICE_AGENT_WS_URL, VOICE_AGENT_WS_TOKEN, kLocalProtocolVersion, "local_lab");
+    if (endpoint.IsValid()) {
+        return endpoint;
+    }
+#endif
+
+    return MakeEndpointSnapshot(
+        websocket.GetString("url"),
+        upstream_token,
+        websocket.GetInt("version", kLocalProtocolVersion),
+        "upstream_websocket_nvs");
+}
+
+}  // namespace
