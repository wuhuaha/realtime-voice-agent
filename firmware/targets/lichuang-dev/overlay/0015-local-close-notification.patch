+void WebsocketProtocol::NotifyAudioChannelClosed(uint32_t connection_generation) {
+    uint32_t notified_generation =
+        closed_notification_generation_.load(std::memory_order_acquire);
+    while (connection_generation > notified_generation) {
+        if (closed_notification_generation_.compare_exchange_weak(
+                notified_generation, connection_generation,
+                std::memory_order_acq_rel, std::memory_order_acquire)) {
+            ESP_LOGI(TAG, "Audio channel closed generation=%lu",
+                     static_cast<unsigned long>(connection_generation));
+            const auto channel_closed_callback = on_audio_channel_closed_;
+            if (channel_closed_callback != nullptr) {
+                channel_closed_callback();
+            }
+            return;
+        }
+    }
+}
