+class VoiceAgentDisplay : public SpiLcdDisplay {
+private:
+    lv_obj_t* user_text_ = nullptr;
+    lv_obj_t* assistant_text_ = nullptr;
+    lv_obj_t* action_button_ = nullptr;
+    lv_obj_t* action_icon_ = nullptr;
+
+    static lv_color_t ColorBackground() { return lv_color_hex(0x101516); }
+    static lv_color_t ColorSurface() { return lv_color_hex(0x1B2324); }
+    static lv_color_t ColorText() { return lv_color_hex(0xF3F7F5); }
+    static lv_color_t ColorMuted() { return lv_color_hex(0x91A19A); }
+    static lv_color_t ColorIdle() { return lv_color_hex(0x56635E); }
+    static lv_color_t ColorListening() { return lv_color_hex(0x38D6A0); }
+    static lv_color_t ColorSpeaking() { return lv_color_hex(0xFFB84D); }
+    static lv_color_t ColorConnecting() { return lv_color_hex(0x4FB7D8); }
+
+    void SetActionColor(lv_color_t color) {
+        if (action_button_ != nullptr) {
+            lv_obj_set_style_bg_color(action_button_, color, LV_PART_MAIN);
+            lv_obj_set_style_shadow_color(action_button_, color, LV_PART_MAIN);
+        }
+    }
+
+public:
+    VoiceAgentDisplay(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_handle_t panel,
+                      int width, int height, int offset_x, int offset_y,
+                      bool mirror_x, bool mirror_y, bool swap_xy)
+        : SpiLcdDisplay(panel_io, panel, width, height, offset_x, offset_y,
+                        mirror_x, mirror_y, swap_xy) {}
+
+    void SetupUI() override {
+        if (setup_ui_called_) {
+            return;
+        }
+        Display::SetupUI();
+        DisplayLockGuard lock(this);
+
+        auto theme = static_cast<LvglTheme*>(current_theme_);
+        auto text_font = theme->text_font()->font();
+        auto icon_font = theme->large_icon_font()->font();
+        auto screen = lv_screen_active();
+
+        lv_obj_set_style_bg_color(screen, ColorBackground(), 0);
+        lv_obj_set_style_text_color(screen, ColorText(), 0);
+        lv_obj_set_style_text_font(screen, text_font, 0);
+
+        container_ = lv_obj_create(screen);
+        lv_obj_set_size(container_, width_, height_);
+        lv_obj_set_style_bg_color(container_, ColorBackground(), 0);
+        lv_obj_set_style_border_width(container_, 0, 0);
+        lv_obj_set_style_radius(container_, 0, 0);
+        lv_obj_set_style_pad_all(container_, 0, 0);
+        lv_obj_clear_flag(container_, LV_OBJ_FLAG_SCROLLABLE);
+
+        top_bar_ = lv_obj_create(container_);
+        lv_obj_set_size(top_bar_, width_, 36);
+        lv_obj_set_style_bg_color(top_bar_, ColorBackground(), 0);
+        lv_obj_set_style_border_width(top_bar_, 1, 0);
+        lv_obj_set_style_border_side(top_bar_, LV_BORDER_SIDE_BOTTOM, 0);
+        lv_obj_set_style_border_color(top_bar_, lv_color_hex(0x2B3634), 0);
+        lv_obj_set_style_radius(top_bar_, 0, 0);
+        lv_obj_set_style_pad_all(top_bar_, 0, 0);
+        lv_obj_clear_flag(top_bar_, LV_OBJ_FLAG_SCROLLABLE);
+
+        network_label_ = lv_label_create(top_bar_);
+        lv_obj_set_style_text_color(network_label_, ColorMuted(), 0);
+        lv_label_set_text(network_label_, "");
+        lv_obj_align(network_label_, LV_ALIGN_LEFT_MID, 10, 0);
+
+        status_label_ = lv_label_create(top_bar_);
+        lv_obj_set_width(status_label_, 190);
+        lv_obj_set_style_text_align(status_label_, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_style_text_color(status_label_, ColorText(), 0);
+        lv_label_set_long_mode(status_label_, LV_LABEL_LONG_CLIP);
+        lv_label_set_text(status_label_, Lang::Strings::INITIALIZING);
+        lv_obj_align(status_label_, LV_ALIGN_CENTER, 0, 0);
+
+        battery_label_ = lv_label_create(top_bar_);
+        lv_obj_set_style_text_color(battery_label_, ColorMuted(), 0);
+        lv_label_set_text(battery_label_, "");
+        lv_obj_align(battery_label_, LV_ALIGN_RIGHT_MID, -10, 0);
+
+        mute_label_ = lv_label_create(top_bar_);
+        lv_obj_add_flag(mute_label_, LV_OBJ_FLAG_HIDDEN);
+        notification_label_ = lv_label_create(top_bar_);
+        lv_obj_add_flag(notification_label_, LV_OBJ_FLAG_HIDDEN);
+
+        lv_obj_t* transcript = lv_obj_create(container_);
+        lv_obj_set_size(transcript, 202, 184);
+        lv_obj_align(transcript, LV_ALIGN_BOTTOM_LEFT, 8, -10);
+        lv_obj_set_style_bg_color(transcript, ColorSurface(), 0);
+        lv_obj_set_style_border_width(transcript, 0, 0);
+        lv_obj_set_style_radius(transcript, 6, 0);
+        lv_obj_set_style_pad_all(transcript, 10, 0);
+        lv_obj_clear_flag(transcript, LV_OBJ_FLAG_SCROLLABLE);
+
+        lv_obj_t* user_role = lv_label_create(transcript);
+        lv_label_set_text(user_role, "你");
+        lv_obj_set_style_text_color(user_role, ColorListening(), 0);
+        lv_obj_align(user_role, LV_ALIGN_TOP_LEFT, 0, 0);
+
+        user_text_ = lv_label_create(transcript);
+        lv_obj_set_size(user_text_, 182, 52);
+        lv_label_set_long_mode(user_text_, LV_LABEL_LONG_WRAP);
+        lv_obj_set_style_text_color(user_text_, ColorText(), 0);
+        lv_label_set_text(user_text_, "");
+        lv_obj_align(user_text_, LV_ALIGN_TOP_LEFT, 0, 25);
+
+        lv_obj_t* divider = lv_obj_create(transcript);
+        lv_obj_set_size(divider, 182, 1);
+        lv_obj_set_style_bg_color(divider, lv_color_hex(0x34403E), 0);
+        lv_obj_set_style_border_width(divider, 0, 0);
+        lv_obj_align(divider, LV_ALIGN_TOP_LEFT, 0, 81);
+
+        lv_obj_t* assistant_role = lv_label_create(transcript);
+        lv_label_set_text(assistant_role, "小智");
+        lv_obj_set_style_text_color(assistant_role, ColorSpeaking(), 0);
+        lv_obj_align(assistant_role, LV_ALIGN_TOP_LEFT, 0, 91);
+
+        assistant_text_ = lv_label_create(transcript);
+        lv_obj_set_size(assistant_text_, 182, 52);
+        lv_label_set_long_mode(assistant_text_, LV_LABEL_LONG_WRAP);
+        lv_obj_set_style_text_color(assistant_text_, ColorText(), 0);
+        lv_label_set_text(assistant_text_, "");
+        lv_obj_align(assistant_text_, LV_ALIGN_TOP_LEFT, 0, 116);
+
+        action_button_ = lv_button_create(container_);
+        lv_obj_set_size(action_button_, 88, 88);
+        lv_obj_align(action_button_, LV_ALIGN_RIGHT_MID, -11, 16);
+        lv_obj_set_style_radius(action_button_, LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_border_width(action_button_, 3, 0);
+        lv_obj_set_style_border_color(action_button_, lv_color_hex(0xDDE7E2), 0);
+        lv_obj_set_style_bg_color(action_button_, ColorIdle(), 0);
+        lv_obj_set_style_shadow_width(action_button_, 12, 0);
+        lv_obj_set_style_shadow_opa(action_button_, LV_OPA_30, 0);
+        lv_obj_set_style_bg_color(action_button_, lv_color_hex(0x3C4945), LV_STATE_PRESSED);
+        lv_obj_add_event_cb(action_button_, [](lv_event_t* event) {
+            if (lv_event_get_code(event) == LV_EVENT_CLICKED) {
+                Application::GetInstance().ToggleChatState();
+            }
+        }, LV_EVENT_CLICKED, nullptr);
+
+        action_icon_ = lv_label_create(action_button_);
+        lv_obj_set_style_text_font(action_icon_, icon_font, 0);
+        lv_obj_set_style_text_color(action_icon_, ColorText(), 0);
+        lv_label_set_text(action_icon_, FONT_AWESOME_MICROPHONE);
+        lv_obj_center(action_icon_);
+
+        low_battery_popup_ = lv_obj_create(container_);
+        lv_obj_add_flag(low_battery_popup_, LV_OBJ_FLAG_HIDDEN);
+        low_battery_label_ = lv_label_create(low_battery_popup_);
+        lv_label_set_text(low_battery_label_, "");
+    }
+
+    void SetStatus(const char* status) override {
+        DisplayLockGuard lock(this);
+        if (status_label_ == nullptr) {
+            return;
+        }
+        lv_label_set_text(status_label_, status == nullptr ? "" : status);
+        if (status != nullptr && std::strcmp(status, Lang::Strings::LISTENING) == 0) {
+            SetActionColor(ColorListening());
+        } else if (status != nullptr && std::strcmp(status, Lang::Strings::SPEAKING) == 0) {
+            SetActionColor(ColorSpeaking());
+        } else if (status != nullptr && std::strcmp(status, Lang::Strings::CONNECTING) == 0) {
+            SetActionColor(ColorConnecting());
+        } else {
+            SetActionColor(ColorIdle());
+        }
+    }
+
+    void SetTheme(Theme* theme) override {
+        if (theme == nullptr) {
+            return;
+        }
+        DisplayLockGuard lock(this);
+        current_theme_ = theme;
+        auto lvgl_theme = static_cast<LvglTheme*>(theme);
+        auto text_font = lvgl_theme->text_font()->font();
+        auto icon_font = lvgl_theme->icon_font()->font();
+        auto screen = lv_screen_active();
+        lv_obj_set_style_text_font(screen, text_font, 0);
+        if (network_label_ != nullptr) lv_obj_set_style_text_font(network_label_, icon_font, 0);
+        if (battery_label_ != nullptr) lv_obj_set_style_text_font(battery_label_, icon_font, 0);
+        if (mute_label_ != nullptr) lv_obj_set_style_text_font(mute_label_, icon_font, 0);
+    }
+
+    void SetChatMessage(const char* role, const char* content) override {
+        DisplayLockGuard lock(this);
+        const char* text = content == nullptr ? "" : content;
+        if (role != nullptr && std::strcmp(role, "user") == 0 && user_text_ != nullptr) {
+            lv_label_set_text(user_text_, text);
+        } else if (role != nullptr && std::strcmp(role, "assistant") == 0 && assistant_text_ != nullptr) {
+            lv_label_set_text(assistant_text_, text);
+        } else if (role != nullptr && std::strcmp(role, "system") == 0 && text[0] == '\0') {
+            if (user_text_ != nullptr) lv_label_set_text(user_text_, "");
+            if (assistant_text_ != nullptr) lv_label_set_text(assistant_text_, "");
+        }
+    }
+
+    void ClearChatMessages() override {
+        DisplayLockGuard lock(this);
+        if (user_text_ != nullptr) lv_label_set_text(user_text_, "");
+        if (assistant_text_ != nullptr) lv_label_set_text(assistant_text_, "");
+    }
+
+    void SetEmotion(const char*) override {}
+    void SetPreviewImage(std::unique_ptr<LvglImage>) override {}
+};
+
