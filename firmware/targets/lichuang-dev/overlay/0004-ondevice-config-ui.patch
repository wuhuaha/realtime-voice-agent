+    void HandleAsciiKeyboard(const std::string& key) {
+        DisplayLockGuard lock(this);
+        if (ascii_keyboard_ == nullptr || keyboard_target_ == nullptr) {
+            return;
+        }
+        if (key == "ABC") {
+            lv_buttonmatrix_set_map(ascii_keyboard_, kKeyboardUpperMap);
+        } else if (key == "abc") {
+            lv_buttonmatrix_set_map(ascii_keyboard_, kKeyboardLowerMap);
+        } else if (key == "#+=") {
+            lv_buttonmatrix_set_map(ascii_keyboard_, kKeyboardSymbolMap);
+        } else if (key == "空格") {
+            lv_textarea_add_char(keyboard_target_, ' ');
+        } else if (key == "退格") {
+            lv_textarea_delete_char(keyboard_target_);
+        } else if (key == "取消") {
+            ShowHomeUnlocked();
+        } else if (key == "确定") {
+            if (keyboard_target_ == endpoint_textarea_) {
+                SaveEndpointUnlocked();
+            } else if (keyboard_target_ == wifi_password_textarea_) {
+                SaveWifiPasswordUnlocked();
+            }
+        } else {
+            lv_textarea_add_text(keyboard_target_, key.c_str());
+        }
+    }
