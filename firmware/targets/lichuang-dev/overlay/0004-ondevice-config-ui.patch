+    void StartWifiScan(uint32_t generation) {
+        if (scan_running_.exchange(true)) {
+            lv_label_set_text(page_feedback_, "扫描正在完成，请稍后刷新");
+            return;
+        }
+        struct ScanContext {
+            VoiceAgentDisplay* self;
+            uint32_t generation;
+        };
+        auto context = new ScanContext{this, generation};
+        BaseType_t created = xTaskCreate([](void* argument) {
+            std::unique_ptr<ScanContext> context(static_cast<ScanContext*>(argument));
+            std::vector<WifiScanResult> results;
+            esp_err_t error = ESP_OK;
+            wifi_scan_config_t config = {};
+            config.show_hidden = false;
+            config.scan_type = WIFI_SCAN_TYPE_ACTIVE;
+            config.scan_time.active.min = 80;
+            config.scan_time.active.max = 160;
+            error = esp_wifi_scan_start(&config, true);
+            if (error == ESP_OK) {
+                uint16_t count = 0;
+                error = esp_wifi_scan_get_ap_num(&count);
+                count = std::min<uint16_t>(count, 32);
+                if (error == ESP_OK && count > 0) {
+                    std::vector<wifi_ap_record_t> records(count);
+                    error = esp_wifi_scan_get_ap_records(&count, records.data());
+                    if (error == ESP_OK) {
+                        for (uint16_t i = 0; i < count && results.size() < 8; ++i) {
+                            size_t length = strnlen(reinterpret_cast<const char*>(records[i].ssid),
+                                                    sizeof(records[i].ssid));
+                            std::string ssid(reinterpret_cast<const char*>(records[i].ssid), length);
+                            if (ssid.empty()) {
+                                continue;
+                            }
+                            bool duplicate = false;
+                            for (const auto& item : results) {
+                                if (item.ssid == ssid) {
+                                    duplicate = true;
+                                    break;
+                                }
+                            }
+                            if (!duplicate) {
+                                results.push_back({ssid, records[i].rssi,
+                                                   records[i].authmode == WIFI_AUTH_OPEN});
+                            }
+                        }
+                    }
+                }
+            }
+            context->self->scan_running_.store(false);
+            auto self = context->self;
+            const auto completed_generation = context->generation;
+            Application::GetInstance().Schedule(
+                [self, completed_generation, error, results = std::move(results)]() mutable {
+                    self->ShowWifiResults(completed_generation, error, std::move(results));
+                });
+            vTaskDelete(nullptr);
+        }, "wifi_ui_scan", 4096, context, 4, nullptr);
+        if (created != pdPASS) {
+            delete context;
+            scan_running_.store(false);
+            lv_label_set_text(page_feedback_, "无法启动扫描，请重试");
+        }
+    }
+
+    void ShowWifiResults(uint32_t generation, esp_err_t error,
+                         std::vector<WifiScanResult>&& results) {
+        DisplayLockGuard lock(this);
+        if (generation != page_generation_.load() || page_overlay_ == nullptr) {
