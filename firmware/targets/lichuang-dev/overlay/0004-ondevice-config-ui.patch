+            lv_obj_set_width(page_feedback_, width_ - 24);
+            lv_obj_set_style_text_align(page_feedback_, LV_TEXT_ALIGN_CENTER, 0);
+            lv_obj_set_style_text_color(page_feedback_, error == ESP_OK ? ColorMuted() : ColorDanger(), 0);
+            lv_label_set_text(page_feedback_, error == ESP_OK ? "未发现可用网络" : "扫描失败，请点击刷新");
+            lv_obj_align(page_feedback_, LV_ALIGN_CENTER, 0, 0);
+            if (error != ESP_OK) {
+                ESP_LOGW(TAG, "Wi-Fi scan failed: %s", esp_err_to_name(error));
+            }
+            return;
+        }
+
+        auto list = lv_obj_create(page_overlay_);
+        lv_obj_set_size(list, width_ - 16, height_ - 48);
+        lv_obj_align(list, LV_ALIGN_BOTTOM_MID, 0, -4);
+        lv_obj_set_style_bg_color(list, ColorBackground(), 0);
+        lv_obj_set_style_border_width(list, 0, 0);
+        lv_obj_set_style_pad_all(list, 4, 0);
+        lv_obj_set_style_pad_row(list, 4, 0);
+        lv_obj_set_flex_flow(list, LV_FLEX_FLOW_COLUMN);
+        for (size_t index = 0; index < wifi_results_.size(); ++index) {
+            const auto& result = wifi_results_[index];
+            std::string caption = result.ssid;
+            caption += result.open ? "  开放" : "  加密";
+            auto button = lv_button_create(list);
+            lv_obj_set_width(button, LV_PCT(100));
+            lv_obj_set_height(button, 40);
+            lv_obj_set_style_bg_color(button, ColorSurface(), 0);
+            lv_obj_set_style_bg_color(button, lv_color_hex(0x283432), LV_STATE_PRESSED);
+            auto icon = lv_label_create(button);
+            auto theme = static_cast<LvglTheme*>(current_theme_);
+            lv_obj_set_style_text_font(icon, theme->icon_font()->font(), 0);
+            lv_obj_set_style_text_color(icon, ColorListening(), 0);
+            lv_label_set_text(icon, result.rssi >= -65 ? FONT_AWESOME_WIFI : FONT_AWESOME_WIFI_WEAK);
+            lv_obj_align(icon, LV_ALIGN_LEFT_MID, 0, 0);
+            auto label = lv_label_create(button);
+            lv_obj_set_width(label, width_ - 82);
+            lv_label_set_long_mode(label, LV_LABEL_LONG_DOT);
+            lv_label_set_text(label, caption.c_str());
+            lv_obj_align(label, LV_ALIGN_LEFT_MID, 28, 0);
+            lv_obj_set_user_data(button, reinterpret_cast<void*>(index + 1));
+            lv_obj_add_event_cb(button, [](lv_event_t* event) {
+                auto self = static_cast<VoiceAgentDisplay*>(lv_event_get_user_data(event));
+                size_t index = reinterpret_cast<uintptr_t>(lv_obj_get_user_data(lv_event_get_target_obj(event))) - 1;
+                Application::GetInstance().Schedule([self, index]() { self->SelectWifi(index); });
+            }, LV_EVENT_CLICKED, this);
+        }
+    }
