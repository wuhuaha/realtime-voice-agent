diff --git a/managed_components/78__esp-ml307/src/esp/esp_connection_deadline.h b/managed_components/78__esp-ml307/src/esp/esp_connection_deadline.h
new file mode 100644
index 0000000..695d862
--- /dev/null
+++ b/managed_components/78__esp-ml307/src/esp/esp_connection_deadline.h
@@ -0,0 +1,139 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <new>
+#include <string>
+
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+#include <lwip/dns.h>
+#include <lwip/ip4_addr.h>
+#include <lwip/tcpip.h>
+
+namespace esp_connection_detail {
+
+class Deadline {
+public:
+    explicit Deadline(int timeout_ms)
+        : deadline_us_(esp_timer_get_time() +
+              static_cast<int64_t>(std::max(1, timeout_ms)) * 1000) {}
+
+    int RemainingMs() const {
+        const int64_t remaining_us = deadline_us_ - esp_timer_get_time();
+        if (remaining_us <= 0) {
+            return 0;
+        }
+        return static_cast<int>((remaining_us + 999) / 1000);
+    }
+
+private:
+    int64_t deadline_us_;
+};
+
+namespace dns_detail {
+
+struct Request {
+    std::atomic<unsigned> references{2};
+    SemaphoreHandle_t completed_signal = nullptr;
+    portMUX_TYPE lock = portMUX_INITIALIZER_UNLOCKED;
+    ip_addr_t address{};
+    std::string host;
+    bool completed = false;
+    bool succeeded = false;
+};
+
+inline void DeleteRequest(Request* request) {
+    vSemaphoreDelete(request->completed_signal);
+    delete request;
+}
+
+inline void Release(Request* request) {
+    if (request->references.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+        DeleteRequest(request);
+    }
+}
+
+inline void Complete(Request* request, const ip_addr_t* address) {
+    portENTER_CRITICAL(&request->lock);
+    if (address != nullptr && IP_IS_V4(address)) {
+        ip_addr_copy(request->address, *address);
+        request->succeeded = true;
+    }
+    request->completed = true;
+    portEXIT_CRITICAL(&request->lock);
+    xSemaphoreGive(request->completed_signal);
+}
+
+inline void OnResolved(const char*, const ip_addr_t* address, void* argument) {
+    auto* request = static_cast<Request*>(argument);
+    Complete(request, address);
+    Release(request);
+}
+
+inline void Start(void* argument) {
+    auto* request = static_cast<Request*>(argument);
+    const err_t status = dns_gethostbyname_addrtype(
+        request->host.c_str(), &request->address, OnResolved, request,
+        LWIP_DNS_ADDRTYPE_IPV4);
+    if (status == ERR_OK) {
+        Complete(request, &request->address);
+        Release(request);
+    } else if (status != ERR_INPROGRESS) {
+        Complete(request, nullptr);
+        Release(request);
+    }
+}
+
+}  // namespace dns_detail
+
+inline bool ResolveIpv4(const std::string& host, int timeout_ms,
+                        std::string& resolved_address) {
+    if (timeout_ms <= 0) {
+        return false;
+    }
+    auto* request = new (std::nothrow) dns_detail::Request();
+    if (request == nullptr) {
+        return false;
+    }
+    request->completed_signal = xSemaphoreCreateBinary();
+    if (request->completed_signal == nullptr) {
+        delete request;
+        return false;
+    }
+    request->host = host;
+
+    if (tcpip_try_callback(dns_detail::Start, request) != ERR_OK) {
+        dns_detail::Release(request);
+        dns_detail::Release(request);
+        return false;
+    }
+
+    const TickType_t wait_ticks = std::max<TickType_t>(
+        1, pdMS_TO_TICKS(timeout_ms));
+    const bool completed =
+        xSemaphoreTake(request->completed_signal, wait_ticks) == pdTRUE;
+
+    bool succeeded = false;
+    ip_addr_t address{};
+    portENTER_CRITICAL(&request->lock);
+    succeeded = completed && request->completed && request->succeeded;
+    if (succeeded) {
+        ip_addr_copy(address, request->address);
+    }
+    portEXIT_CRITICAL(&request->lock);
+
+    if (succeeded) {
+        char buffer[IP4ADDR_STRLEN_MAX] = {};
+        succeeded = ip4addr_ntoa_r(ip_2_ip4(&address), buffer,
+                                   sizeof(buffer)) != nullptr;
+        if (succeeded) {
+            resolved_address = buffer;
+        }
+    }
+    dns_detail::Release(request);
+    return succeeded;
+}
+
+}  // namespace esp_connection_detail
