+bool WifiStation::RequestScan(
+    std::function<void(esp_err_t, std::vector<wifi_ap_record_t>)> callback) {
+    if (!callback) {
+        return false;
+    }
+    {
+        std::lock_guard<std::mutex> lock(scan_callback_mutex_);
+        if (scan_callback_) {
+            return false;
+        }
+        scan_callback_ = std::move(callback);
+    }
+    const esp_err_t error = esp_wifi_scan_start(nullptr, false);
+    if (error == ESP_OK) {
+        return true;
+    }
+    std::lock_guard<std::mutex> lock(scan_callback_mutex_);
+    scan_callback_ = nullptr;
+    return false;
+}
