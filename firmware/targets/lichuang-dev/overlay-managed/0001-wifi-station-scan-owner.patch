+bool WifiManager::RequestStationScan(
+    std::function<void(esp_err_t, std::vector<wifi_ap_record_t>)> callback) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (!callback) {
+        return false;
+    }
+    if (station_active_ && station_) {
+        return station_->RequestScan(std::move(callback));
+    }
+    if (config_mode_active_ && config_ap_) {
+        auto records = config_ap_->GetAccessPoints();
+        lock.unlock();
+        callback(ESP_OK, std::move(records));
+        return true;
+    }
+    return false;
+}
