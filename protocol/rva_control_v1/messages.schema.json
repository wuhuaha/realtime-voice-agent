{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-voice-agent.local/protocol/rva-control-v1/messages.schema.json",
  "title": "Realtime Voice Agent Control Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/sessionOpen" },
    { "$ref": "#/$defs/sessionOpened" },
    { "$ref": "#/$defs/transcriptDelta" },
    { "$ref": "#/$defs/transcriptFinal" },
    { "$ref": "#/$defs/responseBegin" },
    { "$ref": "#/$defs/responseText" },
    { "$ref": "#/$defs/responseEnd" },
    { "$ref": "#/$defs/responseCancel" },
    { "$ref": "#/$defs/responseCancelled" },
    { "$ref": "#/$defs/sessionError" },
    { "$ref": "#/$defs/sessionClose" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "sessionEpoch": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "mediaEpoch": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "mediaId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "audio": {
      "type": "object",
      "required": ["codec", "sample_rate_hz", "channels", "frame_duration_ms"],
      "properties": {
        "codec": { "const": "opus" },
        "sample_rate_hz": { "const": 16000 },
        "channels": { "const": 1 },
        "frame_duration_ms": { "const": 60 }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "aec": { "type": "boolean" },
        "vad": { "type": "boolean" },
        "wake_word": { "type": "boolean" },
        "display": { "type": "boolean" },
        "touch": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "udpGrant": {
      "type": "object",
      "required": [
        "host", "port", "expires_at_ms", "uplink_key_b64", "uplink_salt_b64",
        "downlink_key_b64", "downlink_salt_b64", "probe_timeout_ms"
      ],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "expires_at_ms": { "type": "integer", "minimum": 1 },
        "uplink_key_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$" },
        "uplink_salt_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{11}=$" },
        "downlink_key_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$" },
        "downlink_salt_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{11}=$" },
        "probe_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 10000 }
      },
      "additionalProperties": false
    },
    "cancelTarget": {
      "type": "object",
      "required": ["response_id", "generation"],
      "properties": {
        "response_id": { "$ref": "#/$defs/id" },
        "generation": { "$ref": "#/$defs/generation" }
      },
      "additionalProperties": false
    },
    "sessionOpen": {
      "type": "object",
      "required": [
        "type", "protocol_version", "request_id", "device_id", "supported_media_profiles",
        "preferred_media_profile", "audio", "capabilities"
      ],
      "properties": {
        "type": { "const": "session.open" },
        "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/id" },
        "device_id": { "$ref": "#/$defs/id" },
        "supported_media_profiles": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["wss-opus-v2", "udp-opus-gcm-v1"] }
        },
        "preferred_media_profile": { "enum": ["wss-opus-v2", "udp-opus-gcm-v1"] },
        "audio": { "$ref": "#/$defs/audio" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      },
      "additionalProperties": false
    },
    "sessionOpened": {
      "type": "object",
      "required": [
        "type", "request_id", "session_id", "session_epoch", "media_id", "media_epoch",
        "selected_media_profile", "audio",
        "heartbeat_interval_ms", "idle_timeout_ms", "max_control_message_bytes"
      ],
      "properties": {
        "type": { "const": "session.opened" },
        "request_id": { "$ref": "#/$defs/id" },
        "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" },
        "media_id": { "$ref": "#/$defs/mediaId" },
        "media_epoch": { "$ref": "#/$defs/mediaEpoch" },
        "selected_media_profile": { "enum": ["wss-opus-v2", "udp-opus-gcm-v1"] },
        "audio": { "$ref": "#/$defs/audio" },
        "heartbeat_interval_ms": { "type": "integer", "minimum": 5000, "maximum": 60000 },
        "idle_timeout_ms": { "type": "integer", "minimum": 15000, "maximum": 180000 },
        "max_control_message_bytes": { "const": 32768 },
        "udp_grant": { "$ref": "#/$defs/udpGrant" }
      },
      "allOf": [
        {
          "if": { "properties": { "selected_media_profile": { "const": "udp-opus-gcm-v1" } } },
          "then": { "required": ["udp_grant"] },
          "else": { "not": { "required": ["udp_grant"] } }
        }
      ],
      "additionalProperties": false
    },
    "transcriptDelta": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "utterance_id", "sequence", "text"],
      "properties": {
        "type": { "const": "transcript.delta" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" }, "utterance_id": { "$ref": "#/$defs/id" },
        "sequence": { "$ref": "#/$defs/sequence" }, "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "transcriptFinal": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "utterance_id", "sequence", "text"],
      "properties": {
        "type": { "const": "transcript.final" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" }, "utterance_id": { "$ref": "#/$defs/id" },
        "sequence": { "$ref": "#/$defs/sequence" }, "text": { "type": "string", "maxLength": 16384 }
      },
      "additionalProperties": false
    },
    "responseBegin": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "response_id", "generation"],
      "properties": {
        "type": { "const": "response.begin" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" }, "response_id": { "$ref": "#/$defs/id" },
        "generation": { "$ref": "#/$defs/generation" }
      },
      "additionalProperties": false
    },
    "responseText": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "response_id", "generation", "sequence", "text"],
      "properties": {
        "type": { "const": "response.text" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" }, "response_id": { "$ref": "#/$defs/id" },
        "generation": { "$ref": "#/$defs/generation" }, "sequence": { "$ref": "#/$defs/sequence" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "responseEnd": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "response_id", "generation", "reason"],
      "properties": {
        "type": { "const": "response.end" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" }, "response_id": { "$ref": "#/$defs/id" },
        "generation": { "$ref": "#/$defs/generation" }, "reason": { "enum": ["completed", "failed"] }
      },
      "additionalProperties": false
    },
    "responseCancel": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "target", "reason"],
      "properties": {
        "type": { "const": "response.cancel" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" }, "target": { "$ref": "#/$defs/cancelTarget" },
        "reason": { "enum": ["user_request", "barge_in", "new_wake", "session_close"] }
      },
      "additionalProperties": false
    },
    "responseCancelled": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "target", "reason"],
      "properties": {
        "type": { "const": "response.cancelled" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" }, "target": { "$ref": "#/$defs/cancelTarget" },
        "reason": { "enum": ["cancelled", "already_cancelled", "already_finished"] }
      },
      "additionalProperties": false
    },
    "sessionError": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "code", "retryable", "message"],
      "properties": {
        "type": { "const": "session.error" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" },
        "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_]+$" },
        "retryable": { "type": "boolean" }, "message": { "type": "string", "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "sessionClose": {
      "type": "object",
      "required": ["type", "session_id", "session_epoch", "reason", "initiated_by"],
      "properties": {
        "type": { "const": "session.close" }, "session_id": { "$ref": "#/$defs/id" },
        "session_epoch": { "$ref": "#/$defs/sessionEpoch" },
        "reason": { "enum": ["normal", "idle_timeout", "network_change", "protocol_error", "server_shutdown"] },
        "initiated_by": { "enum": ["device", "server"] }, "detail": { "type": "string", "maxLength": 256 }
      },
      "additionalProperties": false
    }
  }
}
