# Copy this file to .env on the target host, restrict it to the deployment account,
# and replace every replace-with-* value. Startup rejects repository placeholders.
# The real .env is ignored by Git.

# Compose publication and image settings (not application secrets).
VOICE_SERVER_IMAGE=realtime-voice-agent-server:local
# A tag is convenient for local use but is mutable. Controlled releases should set
# both images to an image@sha256:<verified-digest> identity recorded by CI/release tooling.
VOICE_REDIS_IMAGE=redis:7.4.5-alpine
VOICE_DIRECTOR_PUBLISH_BIND=127.0.0.1
VOICE_DIRECTOR_PUBLISH_PORT=8080
VOICE_WORKER_PUBLISH_BIND=127.0.0.1
VOICE_WORKER_PUBLISH_PORT=8081
VOICE_UDP_PUBLISH_BIND=0.0.0.0
VOICE_UDP_PUBLIC_PORT=8092

# This stack expects TLS/WSS termination outside Compose. These URLs must be the
# externally reachable endpoints returned to devices, not container-local URLs.
VOICE_RVA_PUBLIC_WS_URL=wss://voice.example.com/rva/v1/voice

# Director and shared coordination.
VOICE_COORDINATION_PREFIX=realtime-voice-agent
VOICE_REDIS_CONNECT_TIMEOUT_SECONDS=1
VOICE_REDIS_COMMAND_TIMEOUT_SECONDS=1
VOICE_INTERNAL_TOKEN=replace-with-internal-token-at-least-32-random-bytes
VOICE_GRANT_SIGNING_KEY=replace-with-grant-signing-key-at-least-32-random-bytes
# JSON shape: {"tenant-id":{"device-id":"device-secret"}}
VOICE_DEVICE_CREDENTIALS={"tenant-id":{"device-id":"replace-with-device-secret"}}

# One stateful worker. Capacity is an operator-controlled assumption, not a measured SLO.
VOICE_WORKER_ID=worker-single-1
VOICE_WORKER_MAX_SESSIONS=5
VOICE_HEARTBEAT_INTERVAL_SECONDS=5
VOICE_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=10
VOICE_AGENT_CLOSE_STAGE_TIMEOUT_SECONDS=2

# Current RVA WSS + fixed-port authenticated UDP media.
VOICE_RVA_UDP_ENABLED=true
VOICE_UDP_ADVERTISE_HOST=voice.example.com
VOICE_UDP_PROBE_TIMEOUT_SECONDS=3
VOICE_UDP_SESSION_LIFETIME_SECONDS=600
VOICE_UDP_QUEUE_DATAGRAMS=32
VOICE_UDP_REORDER_WAIT_MS=30

# Roomless LiveKit Agent runtime and remote providers.
VOICE_RUNNER=livekit
VOICE_PROVIDER_READINESS_REQUIRED=true
VOICE_LLM_BASE_URL=https://api.deepseek.com
VOICE_LLM_API_KEY=replace-with-provider-api-key
VOICE_LLM_MODEL=deepseek-v4-flash
VOICE_FUNASR_URL=wss://asr.example.com/v1/asr/stream
VOICE_FUNASR_PROTOCOL=standalone
VOICE_TTS_PROVIDER=remote_cosyvoice
VOICE_TTS_QUEUE_TIMEOUT_SECONDS=0.25
VOICE_COSYVOICE_URL=https://tts.example.com
VOICE_COSYVOICE_MODEL=cosyvoice3
VOICE_COSYVOICE_VOICE=mumu
VOICE_VAD_ACTIVATION_THRESHOLD=0.10
VOICE_VAD_DEACTIVATION_THRESHOLD=0.10
VOICE_VAD_IDLE_RESET_SECONDS=30
VOICE_INTERRUPTION_POLICY_ENABLED=true
VOICE_AGENT_INTERRUPTION_MIN_DURATION_SECONDS=1.2
VOICE_ASR_RECORDING_ENABLED=false
