# Copy to .env and provide deployment-specific values. Never commit real values.
VOICE_ENV=development
VOICE_LOG_LEVEL=INFO

# Director and coordination
VOICE_DIRECTOR_URL=http://127.0.0.1:8080
VOICE_COORDINATION_BACKEND=memory
VOICE_REDIS_URL=redis://127.0.0.1:6379/0
VOICE_INTERNAL_TOKEN=replace-with-random-internal-token
VOICE_GRANT_SIGNING_KEY=replace-with-random-grant-key

# Realtime worker
VOICE_WORKER_ID=worker-local-1
VOICE_WORKER_PUBLIC_WS_URL=ws://127.0.0.1:8081/v1/xiaozhi
VOICE_WORKER_BIND_HOST=0.0.0.0
VOICE_WORKER_BIND_PORT=8081
VOICE_WORKER_MAX_SESSIONS=5
VOICE_LAB_TOKEN=replace-with-device-token

# UDP media
VOICE_XIAOZHI_UDP_ENABLED=true
VOICE_XIAOZHI_UDP_BIND_HOST=0.0.0.0
VOICE_XIAOZHI_UDP_BIND_PORT=0
VOICE_XIAOZHI_UDP_ADVERTISE_HOST=127.0.0.1
VOICE_XIAOZHI_UDP_ADVERTISE_PORT=0
VOICE_XIAOZHI_TRANSPORT_POLICY=prefer_device

# Voice providers
VOICE_RUNNER=livekit
VOICE_FUNASR_URL=http://127.0.0.1:8091
VOICE_FUNASR_API_KEY=
VOICE_LLM_BASE_URL=https://api.deepseek.com/v1
VOICE_LLM_API_KEY=replace-with-provider-key
VOICE_LLM_MODEL=deepseek-chat
VOICE_TTS_PROVIDER=cosyvoice
VOICE_COSYVOICE_URL=http://127.0.0.1:50000
VOICE_COSYVOICE_API_KEY=
