# Copy to .env and provide deployment-specific values. Never commit real values.
VOICE_ENV=development
VOICE_LOG_LEVEL=INFO
VOICE_ALLOW_SHARED_BOOTSTRAP_AUTH=true
VOICE_ALLOW_LAB_AUTH=true

# Director and coordination
VOICE_DIRECTOR_URL=http://127.0.0.1:8080
VOICE_DIRECTOR_BIND_HOST=0.0.0.0
VOICE_DIRECTOR_BIND_PORT=8080
VOICE_COORDINATION_BACKEND=memory
VOICE_REDIS_URL=redis://127.0.0.1:6379/0
VOICE_COORDINATION_PREFIX=voice-agent
VOICE_INTERNAL_TOKEN=replace-with-random-internal-token
VOICE_GRANT_SIGNING_KEY=replace-with-random-grant-key
VOICE_DEVICE_BOOTSTRAP_TOKEN=replace-with-device-bootstrap-token
# Production: disable shared bootstrap auth and provide nested tenant/device credentials as JSON.
VOICE_DEVICE_CREDENTIALS={}

# Realtime worker
VOICE_WORKER_ID=worker-local-1
VOICE_WORKER_BIND_HOST=0.0.0.0
VOICE_WORKER_BIND_PORT=8081
VOICE_WORKER_MAX_SESSIONS=5
VOICE_HEARTBEAT_ENABLED=true
VOICE_HEARTBEAT_INTERVAL_SECONDS=5
VOICE_LAB_TOKEN=replace-with-device-token

# Native RVA endpoint
VOICE_RVA_ENABLED=true
VOICE_RVA_PUBLIC_WS_URL=ws://127.0.0.1:8081/v1/voice
VOICE_RVA_UDP_ENABLED=true
VOICE_RVA_INPUT_QUEUE_PACKETS=8
VOICE_RVA_OUTPUT_QUEUE_ITEMS=12
VOICE_RVA_QUEUE_TIMEOUT_SECONDS=0.2
VOICE_RVA_HANDSHAKE_TIMEOUT_SECONDS=5
VOICE_RVA_RUNNER_TIMEOUT_SECONDS=5
VOICE_RVA_CLOSE_TIMEOUT_SECONDS=5
VOICE_RVA_PLAYBACK_PREBUFFER_PACKETS=4

# Shared UDP gateway. The historical variable prefix remains for compatibility.
VOICE_XIAOZHI_UDP_BIND_HOST=0.0.0.0
VOICE_XIAOZHI_UDP_BIND_PORT=8092
VOICE_XIAOZHI_UDP_ADVERTISE_HOST=127.0.0.1
VOICE_XIAOZHI_UDP_ADVERTISE_PORT=8092

# Legacy Xiaozhi rollback binding
VOICE_WORKER_PUBLIC_WS_URL=ws://127.0.0.1:8081/v1/xiaozhi
VOICE_XIAOZHI_UDP_ENABLED=false
VOICE_XIAOZHI_TRANSPORT_POLICY=force_wss

# Voice providers
VOICE_RUNNER=livekit
VOICE_FUNASR_URL=ws://127.0.0.1:8091/v1/asr/stream
VOICE_FUNASR_PROTOCOL=standalone
VOICE_LLM_BASE_URL=https://api.deepseek.com
VOICE_LLM_API_KEY=replace-with-provider-key
VOICE_LLM_MODEL=deepseek-v4-flash
VOICE_TTS_PROVIDER=remote_cosyvoice
VOICE_COSYVOICE_URL=http://127.0.0.1:50000
VOICE_COSYVOICE_MODEL=cosyvoice3
VOICE_COSYVOICE_VOICE=mumu
VOICE_VAD_ACTIVATION_THRESHOLD=0.60
VOICE_ASR_RECORDING_ENABLED=false
